# Database configuration
DB_DSN=file:cardman.db?_fk=1

# Logging verbosity: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# SSH server port
SSH_PORT=2222

# Path to SSH host key file
# If missing, cardman serve-ssh will generate one automatically.
SSH_HOST_KEY=~/.ssh/cardman_host_key

# TCGDex API key (optional, but recommended to avoid rate limits)
# Get yours at https://tcgdex.dev/
API_KEY=
