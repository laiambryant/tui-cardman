# Database DSN (SQLite, pure-Go driver modernc.org/sqlite)
DB_DSN=file:cardman.db?_pragma=foreign_keys(1)

# Logging verbosity: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# SSH server port (used by the serve-ssh command)
SSH_PORT=2222

# Path to SSH host key file (used by the serve-ssh command)
# Generate with: ssh-keygen -t ed25519 -f cardman_host_key -N ""
SSH_HOST_KEY=~/.ssh/cardman_host_key

# TCGDex API key (optional, but recommended to avoid rate limits)
# Get yours at https://tcgdex.dev/
API_KEY=
